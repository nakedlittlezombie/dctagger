# Copy this file to `.env` before running `docker compose up`.
# The compose file reads these values automatically.
#
#   cp example.env .env
#   mkdir -p config cache music output
#   sudo chown -R "$(id -u):$(id -g)" config cache music output

# --- Web -------------------------------------------------------------------
# Interface to publish on. Use 0.0.0.0 only if you intentionally want LAN access.
DCTAGGER_BIND=127.0.0.1
# Host port mapped to the app's container port (4780).
DCTAGGER_PORT=4780

# --- Storage ---------------------------------------------------------------
# Persistent config/session for DCTagger.
DCTAGGER_CONFIG_DIR=./config
# Discogs API/image cache, embedded-art previews. Safe to delete/rebuild.
DCTAGGER_CACHE_DIR=./cache
# Folder containing album folders (flat or artist/album). Mounted at /music.
DCTAGGER_MUSIC_DIR=./music
# Destination for tagged/renamed albums. Mounted at /output.
DCTAGGER_OUTPUT_DIR=./output

# --- Permissions -----------------------------------------------------------
# UID/GID of the host user that owns config/music/output.
# Defaults match the hardened Node image's `node` user (1000:1000).
# Run `id -u` and `id -g` to find yours.
PUID=1000
PGID=1000

# --- Misc ------------------------------------------------------------------
TZ=Etc/UTC

# Docker Hardened Images require `docker login dhi.io` when building.
# These overrides apply to docker-compose.dev.yml only.
# NODE_DEV_IMAGE=dhi.io/node:24-alpine3.24-dev
# NODE_RUNTIME_IMAGE=dhi.io/node:24-alpine3.24
